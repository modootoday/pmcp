{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tier": {
      "not": {}
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "renames": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "interface": {
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": {}
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "description": "A tier name in kebab case; the default set is open, free, paid and internal."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      },
      "additionalProperties": {}
    },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tier": {
            "not": {}
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "renames": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "interface": {
            "type": "object",
            "properties": {
              "displayName": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": {},
        "title": "Plugin manifest",
        "description": "A native plugin manifest as pmcp reads it from a marketplace."
      }
    }
  },
  "required": [
    "name",
    "plugins"
  ],
  "additionalProperties": {},
  "title": "Marketplace manifest",
  "description": "A native plugin marketplace manifest and the plugins it lists."
}
