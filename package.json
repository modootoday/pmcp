{
  "name": "@modootoday/pmcp",
  "version": "0.1.4",
  "license": "Elastic-2.0",
  "author": "modootoday",
  "description": "An MCP server that finds the skills your installed packages already ship. Reads SKILL.md out of node_modules by shape rather than by path, so it sees the skills, .agent, .claude, .gemini and .codex conventions alike, and keeps session startup flat as the number of installed skills grows.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "skills",
    "agent",
    "node-modules",
    "catalog"
  ],
  "homepage": "https://pmcp.build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modootoday/pmcp.git"
  },
  "bugs": {
    "url": "https://github.com/modootoday/pmcp/issues"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "import": "./dist/stdio.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "bin": {
    "pmcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo",
    "skills",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile ./dist/.tsbuildinfo && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist",
    "catalog:refresh": "node scripts/refresh-catalog.mjs",
    "observations:refresh": "node scripts/refresh-observations.mjs",
    "site:build": "node scripts/build-catalog-pages.mjs && node scripts/build-observation-pages.mjs && node scripts/build-sitemap.mjs",
    "site:deployed": "node scripts/check-deployed.mjs",
    "prepack": "npm run build && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.1",
    "semver": "7.8.5"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/semver": "7.8.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
