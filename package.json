{
  "name": "@modootoday/pmcp",
  "version": "0.13.1",
  "license": "Elastic-2.0",
  "author": "modootoday",
  "description": "Use the skills your packages already ship, and keep your AI tools' project configuration in one place.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "skills",
    "agent",
    "node-modules",
    "catalog"
  ],
  "homepage": "https://pmcp.build",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modootoday/pmcp.git"
  },
  "bugs": {
    "url": "https://github.com/modootoday/pmcp/issues"
  },
  "packageManager": "bun@1.3.14",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stdio": {
      "types": "./dist/stdio.d.ts",
      "import": "./dist/stdio.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "import": "./dist/http.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./mailbox": {
      "types": "./dist/mailbox/index.d.ts",
      "import": "./dist/mailbox/index.js"
    }
  },
  "bin": {
    "pmcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "!dist/.tsbuildinfo",
    "skills",
    "docs/*.md",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit --incremental --tsBuildInfoFile ./dist/.tsbuildinfo --singleThreaded && tsgo -p tsconfig.tests.json --noEmit --singleThreaded",
    "test": "vitest run",
    "clean": "rimraf dist",
    "site:build": "node scripts/build-site-styles.mjs && node scripts/build-site-assets.mjs && node scripts/build-public-pages.mjs && node scripts/build-guide-pages.mjs && node scripts/build-catalog-pages.mjs && node scripts/build-observation-pages.mjs && node scripts/build-sitemap.mjs",
    "site:check": "node scripts/build-site-styles.mjs --check && node scripts/build-site-assets.mjs --check && node scripts/build-public-pages.mjs --check && node scripts/build-guide-pages.mjs --check && node scripts/build-catalog-pages.mjs --check && node scripts/build-observation-pages.mjs --check && node scripts/build-sitemap.mjs --check",
    "site:catalog": "node scripts/refresh-catalog.mjs",
    "site:observations": "node scripts/refresh-observations.mjs",
    "site:topics": "node scripts/refresh-topics.mjs",
    "site:pages": "node scripts/prepare-pages.mjs",
    "skills:check": "bun scripts/check-library-skills.mjs",
    "skills:pack": "bun scripts/pack-library-skills.mjs",
    "docs:check": "prettier --check --ignore-path /dev/null README.md docs/*.md && npm run skills:check && npm run site:check",
    "site:deployed": "node scripts/check-deployed.mjs",
    "prepack": "npm run docs:check && npm run build && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.5.1",
    "semver": "7.8.5",
    "smol-toml": "1.8.0",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/semver": "7.8.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "esbuild": "0.27.4",
    "marked": "18.1.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "three": "0.186.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.0"
  }
}
