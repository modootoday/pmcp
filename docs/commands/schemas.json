{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "string": {
      "type": "string"
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": true
    },
    "feature": {
      "type": "object",
      "required": [
        "feature",
        "enabled",
        "source"
      ],
      "properties": {
        "feature": {
          "$ref": "#/$defs/string"
        },
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/string"
        }
      },
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "required": [
        "name",
        "pid",
        "subject",
        "since"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/string"
        },
        "pid": {
          "type": "number"
        },
        "subject": {
          "$ref": "#/$defs/string"
        },
        "since": {
          "$ref": "#/$defs/string"
        },
        "cwd": {
          "$ref": "#/$defs/string"
        }
      },
      "additionalProperties": false
    },
    "broadcast": {
      "type": "object",
      "required": [
        "id",
        "by",
        "text",
        "since",
        "unseenBy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/string"
        },
        "by": {
          "$ref": "#/$defs/string"
        },
        "text": {
          "$ref": "#/$defs/string"
        },
        "since": {
          "$ref": "#/$defs/string"
        },
        "unseenBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/string"
          }
        }
      },
      "additionalProperties": false
    },
    "sessions": {
      "type": "object",
      "required": [
        "version",
        "live",
        "pause",
        "leases",
        "broadcasts"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "live": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "pause": {
          "anyOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "null"
            }
          ]
        },
        "leases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lease"
          }
        },
        "broadcasts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/broadcast"
          }
        }
      },
      "additionalProperties": false
    },
    "worktree": {
      "type": "object",
      "required": [
        "path",
        "main"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/string"
        },
        "main": {
          "type": "boolean"
        },
        "alias": {
          "$ref": "#/$defs/string"
        },
        "branch": {
          "$ref": "#/$defs/string"
        },
        "behind": {
          "type": "number"
        },
        "ahead": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "required": [
        "name",
        "present",
        "expiresAt",
        "scopes"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/string"
        },
        "present": {
          "type": "boolean"
        },
        "expiresAt": {
          "$ref": "#/$defs/nullableString"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/string"
          }
        },
        "error": {
          "$ref": "#/$defs/string"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "runtime",
        "event",
        "policy",
        "mode",
        "source"
      ],
      "properties": {
        "runtime": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "event": {
          "$ref": "#/$defs/string"
        },
        "policy": {
          "$ref": "#/$defs/string"
        },
        "mode": {
          "$ref": "#/$defs/string"
        },
        "source": {
          "$ref": "#/$defs/string"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "policy",
        "mode",
        "decision",
        "durationMs",
        "skipped",
        "source",
        "verdict",
        "reason"
      ],
      "properties": {
        "policy": {
          "$ref": "#/$defs/string"
        },
        "mode": {
          "$ref": "#/$defs/string"
        },
        "decision": {
          "$ref": "#/$defs/record"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "skipped": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/string"
        },
        "verdict": {
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nullableString"
        }
      },
      "additionalProperties": false
    }
  },
  "schemas": {
    "status": {
      "type": "object",
      "required": [
        "version",
        "config",
        "drift",
        "features",
        "projection",
        "sessions",
        "worktrees",
        "mcp",
        "errors"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "config": {
          "$ref": "#/$defs/string"
        },
        "drift": {
          "type": "boolean"
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "projection": {
          "type": "object",
          "required": [
            "drift",
            "outputs",
            "problems"
          ],
          "properties": {
            "drift": {
              "type": "boolean"
            },
            "outputs": {
              "type": "number"
            },
            "problems": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/string"
              }
            }
          },
          "additionalProperties": false
        },
        "sessions": {
          "$ref": "#/$defs/sessions"
        },
        "worktrees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/worktree"
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auth"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      },
      "additionalProperties": false
    },
    "hooks-list": {
      "type": "object",
      "required": [
        "version",
        "policies"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy"
          }
        }
      },
      "additionalProperties": false
    },
    "hooks-test": {
      "type": "object",
      "required": [
        "version",
        "runtime",
        "event",
        "payload",
        "decision",
        "policies",
        "rendered"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "runtime": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "event": {
          "$ref": "#/$defs/string"
        },
        "payload": {
          "$ref": "#/$defs/record"
        },
        "decision": {
          "$ref": "#/$defs/record"
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "rendered": {
          "type": "object",
          "required": [
            "stdout",
            "exitCode"
          ],
          "properties": {
            "stdout": {
              "$ref": "#/$defs/string"
            },
            "exitCode": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sessions-status": {
      "$ref": "#/$defs/sessions"
    },
    "logs": {
      "type": "object",
      "required": [
        "version",
        "records"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      },
      "additionalProperties": false
    },
    "git-worktree-list": {
      "type": "object",
      "required": [
        "version",
        "worktrees"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "worktrees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/worktree"
          }
        }
      },
      "additionalProperties": false
    },
    "mcp-status": {
      "type": "object",
      "required": [
        "version",
        "name",
        "present",
        "expiresAt",
        "scopes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "name": {
          "$ref": "#/$defs/string"
        },
        "present": {
          "type": "boolean"
        },
        "expiresAt": {
          "$ref": "#/$defs/nullableString"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/string"
          }
        }
      },
      "additionalProperties": false
    },
    "heavy-status": {
      "type": "object",
      "required": [
        "version",
        "schema",
        "enabled",
        "dir",
        "budget",
        "running_weight",
        "legacy_holder",
        "host",
        "lanes",
        "waiters",
        "tickets",
        "grace_24h",
        "outside",
        "skip"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "schema": {
          "const": "pmcp.heavy.status.v1"
        },
        "enabled": {
          "type": "boolean"
        },
        "dir": {
          "$ref": "#/$defs/string"
        },
        "budget": {
          "type": "integer"
        },
        "running_weight": {
          "type": "integer"
        },
        "legacy_holder": {
          "type": "boolean"
        },
        "host": {
          "type": "object",
          "required": [
            "load1",
            "io_some_avg10",
            "io_some_avg60",
            "io_some_avg300",
            "io_window",
            "max_load",
            "max_io",
            "hard_factor",
            "settled"
          ],
          "properties": {
            "load1": {
              "type": [
                "number",
                "null"
              ]
            },
            "io_some_avg10": {
              "type": [
                "number",
                "null"
              ]
            },
            "io_some_avg60": {
              "type": [
                "number",
                "null"
              ]
            },
            "io_some_avg300": {
              "type": [
                "number",
                "null"
              ]
            },
            "io_window": {
              "enum": [
                "avg10",
                "avg60",
                "avg300"
              ]
            },
            "max_load": {
              "type": "number"
            },
            "max_io": {
              "type": "number"
            },
            "hard_factor": {
              "type": "number"
            },
            "settled": {
              "type": "boolean"
            }
          }
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lane",
              "slots",
              "running"
            ],
            "properties": {
              "lane": {
                "$ref": "#/$defs/string"
              },
              "slots": {
                "type": "integer"
              },
              "running": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "pid",
                    "label",
                    "cwd",
                    "lane",
                    "weight",
                    "session",
                    "started",
                    "running_s",
                    "flags",
                    "bypass_reason"
                  ],
                  "properties": {
                    "id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "pid": {
                      "type": "integer"
                    },
                    "label": {
                      "$ref": "#/$defs/string"
                    },
                    "cwd": {
                      "$ref": "#/$defs/string"
                    },
                    "lane": {
                      "$ref": "#/$defs/string"
                    },
                    "weight": {
                      "type": "integer"
                    },
                    "session": {
                      "$ref": "#/$defs/nullableString"
                    },
                    "started": {
                      "$ref": "#/$defs/string"
                    },
                    "running_s": {
                      "type": "integer"
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "grace",
                          "bypass",
                          "over_hold_warn",
                          "over_hold_max"
                        ]
                      }
                    },
                    "bypass_reason": {
                      "$ref": "#/$defs/nullableString"
                    }
                  }
                }
              }
            }
          }
        },
        "waiters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "pid",
              "label",
              "cwd",
              "lane",
              "weight",
              "session",
              "position",
              "waited_s",
              "eta_s"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pid": {
                "type": "integer"
              },
              "label": {
                "$ref": "#/$defs/string"
              },
              "cwd": {
                "$ref": "#/$defs/string"
              },
              "lane": {
                "$ref": "#/$defs/string"
              },
              "weight": {
                "type": "integer"
              },
              "session": {
                "$ref": "#/$defs/nullableString"
              },
              "position": {
                "type": "integer"
              },
              "waited_s": {
                "type": "integer"
              },
              "eta_s": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "grace_24h": {
          "type": "object",
          "required": [
            "count",
            "last"
          ],
          "properties": {
            "count": {
              "type": "integer"
            },
            "last": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "outside": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pid",
              "cpu_percent",
              "io_mbps",
              "command"
            ],
            "properties": {
              "pid": {
                "type": "integer"
              },
              "cpu_percent": {
                "type": "number"
              },
              "io_mbps": {
                "type": "number"
              },
              "command": {
                "$ref": "#/$defs/string"
              }
            }
          }
        },
        "skip": {
          "$ref": "#/$defs/nullableString"
        },
        "tickets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "state",
              "position",
              "label",
              "pid",
              "exit"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/string"
              },
              "state": {
                "enum": [
                  "queued",
                  "running",
                  "done",
                  "lost"
                ]
              },
              "position": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "label": {
                "$ref": "#/$defs/string"
              },
              "pid": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "exit": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    }
  }
}
