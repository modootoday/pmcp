{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "string": {
      "type": "string"
    },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "usageMetrics": {
      "type": "object",
      "required": ["wall_s", "user_s", "sys_s", "max_rss_kb", "read_bytes", "write_bytes"],
      "properties": {
        "wall_s": { "type": "number" },
        "user_s": { "type": "number" },
        "sys_s": { "type": "number" },
        "max_rss_kb": { "type": "number" },
        "read_bytes": { "type": "number" },
        "write_bytes": { "type": "number" }
      },
      "additionalProperties": false
    },
    "nullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": true
    },
    "feature": {
      "type": "object",
      "required": [
        "feature",
        "enabled",
        "source"
      ],
      "properties": {
        "feature": {
          "$ref": "#/$defs/string"
        },
        "enabled": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/string"
        }
      },
      "additionalProperties": false
    },
    "lease": {
      "type": "object",
      "required": [
        "name",
        "pid",
        "subject",
        "since"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/string"
        },
        "pid": {
          "type": "number"
        },
        "subject": {
          "$ref": "#/$defs/string"
        },
        "since": {
          "$ref": "#/$defs/string"
        },
        "cwd": {
          "$ref": "#/$defs/string"
        }
      },
      "additionalProperties": false
    },
    "broadcast": {
      "type": "object",
      "required": [
        "id",
        "by",
        "text",
        "since",
        "unseenBy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/string"
        },
        "by": {
          "$ref": "#/$defs/string"
        },
        "text": {
          "$ref": "#/$defs/string"
        },
        "since": {
          "$ref": "#/$defs/string"
        },
        "unseenBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/string"
          }
        }
      },
      "additionalProperties": false
    },
    "sessions": {
      "type": "object",
      "required": [
        "version",
        "live",
        "pause",
        "leases",
        "broadcasts"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "live": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        },
        "pause": {
          "anyOf": [
            {
              "$ref": "#/$defs/record"
            },
            {
              "type": "null"
            }
          ]
        },
        "leases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/lease"
          }
        },
        "broadcasts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/broadcast"
          }
        },
        "restart": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wake": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "null"]
          }
        }
      },
      "additionalProperties": false
    },
    "worktree": {
      "type": "object",
      "required": [
        "path",
        "main"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/string"
        },
        "main": {
          "type": "boolean"
        },
        "alias": {
          "$ref": "#/$defs/string"
        },
        "branch": {
          "$ref": "#/$defs/string"
        },
        "behind": {
          "type": "number"
        },
        "ahead": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "required": [
        "name",
        "present",
        "expiresAt",
        "scopes"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/string"
        },
        "present": {
          "type": "boolean"
        },
        "expiresAt": {
          "$ref": "#/$defs/nullableString"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/string"
          }
        },
        "error": {
          "$ref": "#/$defs/string"
        }
      },
      "additionalProperties": false
    },
    "policy": {
      "type": "object",
      "required": [
        "runtime",
        "event",
        "policy",
        "mode",
        "source"
      ],
      "properties": {
        "runtime": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "event": {
          "$ref": "#/$defs/string"
        },
        "policy": {
          "$ref": "#/$defs/string"
        },
        "mode": {
          "$ref": "#/$defs/string"
        },
        "source": {
          "$ref": "#/$defs/string"
        }
      },
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "required": [
        "policy",
        "mode",
        "decision",
        "durationMs",
        "skipped",
        "source",
        "verdict",
        "reason"
      ],
      "properties": {
        "policy": {
          "$ref": "#/$defs/string"
        },
        "mode": {
          "$ref": "#/$defs/string"
        },
        "decision": {
          "$ref": "#/$defs/record"
        },
        "durationMs": {
          "type": "number",
          "minimum": 0
        },
        "skipped": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/string"
        },
        "verdict": {
          "enum": [
            "allow",
            "ask",
            "deny"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nullableString"
        },
        "raw": {
          "anyOf": [
            {
              "type": "object",
              "required": ["verdict", "reason"],
              "properties": {
                "verdict": { "type": "string" },
                "reason": { "$ref": "#/$defs/nullableString" }
              },
              "additionalProperties": false
            },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "schemas": {
    "envelope": {
      "type": "object",
      "required": ["schema", "ok", "data", "errors"],
      "properties": {
        "schema": {
          "type": "string",
          "pattern": "^pmcp\\.[a-z0-9-]+(\\.[a-z0-9-]+)*\\.v[0-9]+$"
        },
        "ok": { "type": "boolean" },
        "data": {},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "enum": [
                  "failure",
                  "usage",
                  "missing_optional",
                  "differences",
                  "busy"
                ]
              },
              "message": { "$ref": "#/$defs/string" }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "required": [
        "version",
        "config",
        "drift",
        "lagging",
        "features",
        "projection",
        "sessions",
        "worktrees",
        "mcp",
        "errors"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "config": {
          "$ref": "#/$defs/string"
        },
        "drift": {
          "type": "boolean"
        },
        "lagging": {
          "type": "integer",
          "minimum": 0
        },
        "budget": {
          "type": "object",
          "required": ["rows", "problems"],
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["key", "subject", "value", "limit"],
                "properties": {
                  "key": { "type": "string" },
                  "subject": { "type": "string" },
                  "value": { "type": "number" },
                  "limit": { "type": "number" }
                },
                "additionalProperties": false
              }
            },
            "problems": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "projection": {
          "type": "object",
          "required": [
            "drift",
            "outputs",
            "problems"
          ],
          "properties": {
            "drift": {
              "type": "boolean"
            },
            "outputs": {
              "type": "number"
            },
            "problems": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/string"
              }
            }
          },
          "additionalProperties": false
        },
        "sessions": {
          "$ref": "#/$defs/sessions"
        },
        "worktrees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/worktree"
          }
        },
        "mcp": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/auth"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      },
      "additionalProperties": false
    },
    "hooks-list": {
      "type": "object",
      "required": [
        "version",
        "policies"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy"
          }
        }
      },
      "additionalProperties": false
    },
    "hooks-test": {
      "type": "object",
      "required": [
        "version",
        "runtime",
        "event",
        "payload",
        "decision",
        "policies",
        "rendered"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "runtime": {
          "enum": [
            "claude",
            "codex"
          ]
        },
        "event": {
          "$ref": "#/$defs/string"
        },
        "payload": {
          "$ref": "#/$defs/record"
        },
        "decision": {
          "$ref": "#/$defs/record"
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "rendered": {
          "type": "object",
          "required": [
            "stdout",
            "exitCode"
          ],
          "properties": {
            "stdout": {
              "$ref": "#/$defs/string"
            },
            "exitCode": {
              "type": "number"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "sessions-status": {
      "$ref": "#/$defs/sessions"
    },
    "logs": {
      "type": "object",
      "required": [
        "version",
        "records"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "records": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record"
          }
        }
      },
      "additionalProperties": false
    },
    "git-worktree-list": {
      "type": "object",
      "required": [
        "version",
        "worktrees"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "worktrees": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/worktree"
          }
        }
      },
      "additionalProperties": false
    },
    "mcp-status": {
      "type": "object",
      "required": [
        "version",
        "name",
        "present",
        "expiresAt",
        "scopes"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "name": {
          "$ref": "#/$defs/string"
        },
        "present": {
          "type": "boolean"
        },
        "expiresAt": {
          "$ref": "#/$defs/nullableString"
        },
        "scopes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/string"
          }
        }
      },
      "additionalProperties": false
    },
    "heavy-status": {
      "type": "object",
      "required": [
        "version",
        "schema",
        "enabled",
        "dir",
        "budget",
        "running_weight",
        "legacy_holder",
        "host",
        "lanes",
        "waiters",
        "tickets",
        "grace_24h",
        "outside",
        "skip"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "schema": {
          "const": "pmcp.heavy.status.v1"
        },
        "enabled": {
          "type": "boolean"
        },
        "dir": {
          "$ref": "#/$defs/string"
        },
        "budget": {
          "type": "integer"
        },
        "running_weight": {
          "type": "integer"
        },
        "legacy_holder": {
          "type": "boolean"
        },
        "host": {
          "type": "object",
          "required": [
            "load1",
            "io_some_avg10",
            "io_some_avg60",
            "io_some_avg300",
            "io_window",
            "max_load",
            "max_io",
            "hard_factor",
            "settled"
          ],
          "properties": {
            "load1": {
              "type": [
                "number",
                "null"
              ]
            },
            "io_some_avg10": {
              "type": [
                "number",
                "null"
              ]
            },
            "io_some_avg60": {
              "type": [
                "number",
                "null"
              ]
            },
            "io_some_avg300": {
              "type": [
                "number",
                "null"
              ]
            },
            "io_window": {
              "enum": [
                "avg10",
                "avg60",
                "avg300"
              ]
            },
            "max_load": {
              "type": "number"
            },
            "max_io": {
              "type": "number"
            },
            "hard_factor": {
              "type": "number"
            },
            "settled": {
              "type": "boolean"
            }
          }
        },
        "lanes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "lane",
              "slots",
              "running"
            ],
            "properties": {
              "lane": {
                "$ref": "#/$defs/string"
              },
              "slots": {
                "type": "integer"
              },
              "running": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "pid",
                    "label",
                    "cwd",
                    "lane",
                    "weight",
                    "session",
                    "started",
                    "running_s",
                    "flags",
                    "bypass_reason"
                  ],
                  "properties": {
                    "id": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "pid": {
                      "type": "integer"
                    },
                    "label": {
                      "$ref": "#/$defs/string"
                    },
                    "cwd": {
                      "$ref": "#/$defs/string"
                    },
                    "lane": {
                      "$ref": "#/$defs/string"
                    },
                    "weight": {
                      "type": "integer"
                    },
                    "session": {
                      "$ref": "#/$defs/nullableString"
                    },
                    "started": {
                      "$ref": "#/$defs/string"
                    },
                    "running_s": {
                      "type": "integer"
                    },
                    "flags": {
                      "type": "array",
                      "items": {
                        "enum": [
                          "grace",
                          "bypass",
                          "over_hold_warn",
                          "over_hold_max"
                        ]
                      }
                    },
                    "bypass_reason": {
                      "$ref": "#/$defs/nullableString"
                    }
                  }
                }
              }
            }
          }
        },
        "waiters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "pid",
              "label",
              "cwd",
              "lane",
              "weight",
              "session",
              "position",
              "waited_s",
              "eta_s"
            ],
            "properties": {
              "id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "pid": {
                "type": "integer"
              },
              "label": {
                "$ref": "#/$defs/string"
              },
              "cwd": {
                "$ref": "#/$defs/string"
              },
              "lane": {
                "$ref": "#/$defs/string"
              },
              "weight": {
                "type": "integer"
              },
              "session": {
                "$ref": "#/$defs/nullableString"
              },
              "position": {
                "type": "integer"
              },
              "waited_s": {
                "type": "integer"
              },
              "eta_s": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        },
        "grace_24h": {
          "type": "object",
          "required": [
            "count",
            "last"
          ],
          "properties": {
            "count": {
              "type": "integer"
            },
            "last": {
              "$ref": "#/$defs/nullableString"
            }
          }
        },
        "outside": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "pid",
              "cpu_percent",
              "io_mbps",
              "command"
            ],
            "properties": {
              "pid": {
                "type": "integer"
              },
              "cpu_percent": {
                "type": "number"
              },
              "io_mbps": {
                "type": "number"
              },
              "command": {
                "$ref": "#/$defs/string"
              }
            }
          }
        },
        "skip": {
          "$ref": "#/$defs/nullableString"
        },
        "tickets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "state",
              "position",
              "label",
              "pid",
              "exit"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/string"
              },
              "state": {
                "enum": [
                  "queued",
                  "running",
                  "done",
                  "lost"
                ]
              },
              "position": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "label": {
                "$ref": "#/$defs/string"
              },
              "pid": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "exit": {
                "type": [
                  "integer",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
    "heavy-queue": {
      "type": "object",
      "required": ["version", "schema", "waiters"],
      "properties": {
        "version": { "const": 1 },
        "schema": { "const": "pmcp.heavy.queue.v1" },
        "waiters": { "$ref": "#/schemas/heavy-status/properties/waiters" }
      },
      "additionalProperties": false
    },
    "whoami": {
      "type": "object",
      "required": ["signedIn"],
      "properties": {
        "signedIn": { "type": "boolean" },
        "issuer": { "type": "string" },
        "scope": { "type": "string" },
        "expiresInMinutes": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "heavy-stats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["signature", "samples", "failed", "timeouts", "skipped", "p50", "p90"],
        "properties": {
          "signature": { "type": "string" },
          "samples": { "type": "integer", "minimum": 0 },
          "failed": { "type": "integer", "minimum": 0 },
          "timeouts": { "type": "integer", "minimum": 0 },
          "skipped": { "type": "integer", "minimum": 0 },
          "p50": { "$ref": "#/$defs/usageMetrics" },
          "p90": { "$ref": "#/$defs/usageMetrics" }
        },
        "additionalProperties": false
      }
    },
    "hooks-report": {
      "anyOf": [
        {
          "type": "object",
          "required": ["version", "lines", "sessions", "excluded", "guards"],
          "properties": {
            "version": { "const": 1 },
            "since": { "type": "string" },
            "lines": { "type": "integer", "minimum": 0 },
            "sessions": { "type": "integer", "minimum": 0 },
            "excluded": { "type": "integer", "minimum": 0 },
            "guards": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["policy", "runtime", "calls", "raw", "verdict", "modes", "sessions", "durationMs"],
                "properties": {
                  "policy": { "type": "string" },
                  "runtime": { "type": "string" },
                  "calls": { "type": "integer", "minimum": 0 },
                  "raw": { "$ref": "#/$defs/counts" },
                  "verdict": { "$ref": "#/$defs/counts" },
                  "modes": { "type": "array", "items": { "type": "string" } },
                  "sessions": { "type": "integer", "minimum": 0 },
                  "durationMs": {
                    "type": "object",
                    "required": ["p50", "p95", "max"],
                    "properties": {
                      "p50": { "type": "number" },
                      "p95": { "type": "number" },
                      "max": { "type": "number" }
                    },
                    "additionalProperties": false
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["version", "guard", "refused"],
          "properties": {
            "version": { "const": 1 },
            "guard": { "type": "string" },
            "refused": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["ts", "policy", "runtime", "session", "mode", "raw", "verdict", "durationMs"],
                "properties": {
                  "ts": { "type": "string" },
                  "policy": { "type": "string" },
                  "runtime": { "type": "string" },
                  "session": { "type": "string" },
                  "mode": { "type": "string" },
                  "raw": { "type": "string" },
                  "verdict": { "type": "string" },
                  "tool": { "type": "string" },
                  "durationMs": { "type": "number" }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "validate": {
      "type": "object",
      "required": ["findings"],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "reason", "level"],
            "properties": {
              "path": { "type": "string" },
              "reason": { "type": "string" },
              "level": { "enum": ["error", "warning"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "modelId", "dtype", "dtypes", "dimensions", "revision", "encoder"],
        "properties": {
          "name": { "type": "string" },
          "modelId": { "type": "string" },
          "dtype": { "enum": ["q4", "q8", "fp32"] },
          "dtypes": { "type": "array", "items": { "enum": ["q4", "q8", "fp32"] } },
          "dimensions": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
          "revision": { "type": "string" },
          "encoder": {
            "type": "object",
            "required": ["queryPrefix", "passagePrefix", "pooling"],
            "properties": {
              "queryPrefix": { "type": "string" },
              "passagePrefix": { "type": "string" },
              "pooling": { "enum": ["mean", "cls"] },
              "projected": { "type": "boolean" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "marketplace-list": {
      "type": "object",
      "required": ["marketplace", "plugins"],
      "properties": {
        "marketplace": { "type": "string" },
        "plugins": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" },
              "version": { "type": "string" },
              "description": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "marketplace-export": {
      "type": "object",
      "required": ["plugin", "runtime", "output", "files"],
      "properties": {
        "plugin": { "type": "string" },
        "runtime": { "enum": ["claude", "codex", "gemini", "grok", "agy"] },
        "output": { "type": "string" },
        "files": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "owners": {
      "type": "object",
      "required": ["version", "paths"],
      "properties": {
        "version": { "const": 1 },
        "paths": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "owners"],
            "properties": {
              "path": { "type": "string" },
              "owners": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["owner", "mode"],
                  "properties": {
                    "owner": { "type": "string" },
                    "note": { "type": "string" },
                    "mode": { "enum": ["warn", "observe"] }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "doctor": {
      "type": "object",
      "required": ["findings"],
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "check", "status"],
            "properties": {
              "tool": { "enum": ["claude", "codex", "gemini", "grok", "antigravity", "opencode", "project"] },
              "check": { "type": "string" },
              "status": { "enum": ["ok", "fail", "warn", "skip"] },
              "detail": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["feature", "enabled", "projected", "claude", "codex", "codexTrust", "cells"],
            "properties": {
              "feature": { "type": "string" },
              "enabled": { "enum": ["toml", "auto", "default-off"] },
              "projected": { "enum": ["yes", "drift", "no", "-"] },
              "claude": { "type": "string" },
              "codex": { "type": "string" },
              "codexTrust": { "type": "string" },
              "cells": {
                "type": "object",
                "required": ["claude", "codex", "gemini", "antigravity", "grok", "opencode"],
                "properties": {
                  "claude": { "type": "string" },
                  "codex": { "type": "string" },
                  "gemini": { "type": "string" },
                  "antigravity": { "type": "string" },
                  "grok": { "type": "string" },
                  "opencode": { "type": "string" }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "sessions-inbox": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "body", "createdAt", "expiresAt", "once", "acked"],
        "properties": {
          "id": { "type": "string" },
          "from": {
            "type": "object",
            "properties": {
              "session": { "type": "string" },
              "alias": { "type": "string" }
            }
          },
          "to": { "type": "array", "items": { "type": "string" } },
          "subject": { "type": "string" },
          "body": { "type": "string" },
          "createdAt": { "type": "string" },
          "expiresAt": { "type": "string" },
          "replyTo": { "type": "string" },
          "once": { "type": "boolean" },
          "broadcastId": { "type": "string" },
          "acked": { "type": "boolean" }
        }
      }
    },
    "heavy-result": {
      "type": "object",
      "required": ["version", "id", "state", "label", "pid", "position", "result"],
      "properties": {
        "version": { "const": 1 },
        "id": { "type": "string", "pattern": "^\\d{10}-[0-9a-f]{6}$" },
        "state": { "enum": ["queued", "running", "done", "lost"] },
        "label": { "type": "string" },
        "pid": { "type": ["integer", "null"], "minimum": 1 },
        "position": { "type": ["integer", "null"], "minimum": 1 },
        "result": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "required": ["version", "ticket", "exit", "outcome"],
              "properties": {
                "version": { "const": 1 },
                "ticket": { "type": "string" },
                "exit": { "type": "integer" },
                "outcome": { "enum": ["ran", "timeout", "cancelled", "invalid"] },
                "at": { "type": "string" },
                "signature": { "type": "string" },
                "dir": { "type": "string" },
                "lane": { "type": "string" },
                "weight": { "type": "number" },
                "start": { "enum": ["queue", "grace", "bypass", "none"] },
                "wall_s": { "type": "number" },
                "user_s": { "type": "number" },
                "sys_s": { "type": "number" },
                "max_rss_kb": { "type": "number" },
                "read_bytes": { "type": "number" },
                "write_bytes": { "type": "number" },
                "source": { "enum": ["cgroup", "proc", "none"] },
                "skip": { "type": "string" },
                "skip_refused": { "type": "string" },
                "skip_invalid": { "type": "string" },
                "skip_env": { "type": "string" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
